# Copy this file to .env and fill in your key
OPENAI_API_KEY=sk-...

# Every agent uses this model (cheap + capable). Change it here if you like.
STUDIO_MODEL=openai/gpt-5.4-mini

# How many automatic QA -> fix rounds before the crew stops on its own
STUDIO_MAX_REVIEW_ROUNDS=2

# auto = use Docker if it is running, otherwise run code locally with uv
# docker | local | auto
STUDIO_RUNNER=auto

# Let the frontend engineer look up up-to-date Gradio docs through Context7 MCP (1/0)
STUDIO_USE_CONTEXT7=1

# Keep CrewAI from asking about tracing on every run
CREWAI_TRACING_ENABLED=false
