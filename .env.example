# Copy this file to .env and fill in your key

# ── Choose your LLM ─────────────────────────────────────────────
# openai | anthropic | openrouter | grok | gemini | deepseek | ollama
STUDIO_PROVIDER=openai

# Key for the provider you picked
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...
# XAI_API_KEY=xai-...
# GEMINI_API_KEY=...
# DEEPSEEK_API_KEY=...

# Optional: model for the whole team (defaults per provider:
#   openai gpt-5.4-mini · anthropic claude-opus-5-5 · openrouter openai/gpt-5.4-mini
#   grok grok-4.7 · gemini gemini-2.5-flash · deepseek deepseek-chat · ollama llama3.2)
# STUDIO_MODEL=gpt-5.4-mini

# Optional: a stronger model just for the Engineering Lead and Architect (same provider)
# STUDIO_MANAGER_MODEL=gpt-5.4

# Optional: output cap per LLM call for non-OpenAI providers
# STUDIO_MAX_TOKENS=8192

# ── Team behaviour ──────────────────────────────────────────────
# How many automatic QA -> fix rounds before the crew stops on its own
STUDIO_MAX_REVIEW_ROUNDS=2

# auto = use Docker if it is running, otherwise run code locally with uv
# docker | local | auto
STUDIO_RUNNER=auto

# Let the architect and frontend engineer look up up-to-date Gradio docs through Context7 MCP (1/0)
STUDIO_USE_CONTEXT7=1

# Keep CrewAI from asking about tracing on every run
CREWAI_TRACING_ENABLED=false

# ── Hosting (optional) ──────────────────────────────────────────
# Require a login when the app is deployed on a server (strongly recommended)
# APP_USERNAME=admin
# APP_PASSWORD=choose-a-strong-password
